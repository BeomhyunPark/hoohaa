{
  "name": "hoohaa-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "screenshot": "node tools/screenshot.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@hoohaa/engine/(.*)$": "<rootDir>/../src/engine/$1"
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
